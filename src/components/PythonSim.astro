---
import { UI } from "../data/ui";
import type { Lang, Mission } from "../data/types";

interface Props {
  lang: Lang;
  missions: Mission[];
}

const { lang, missions } = Astro.props;
const t = UI[lang].practice;
const runLabel =
  lang === "ja" ? "実行" : lang === "uz" ? "Ishga tushirish" : "Run";
---

<div
  class="term-wrap"
  id="py-app"
  data-mission-complete={t.missionComplete}
  data-missions-done={t.missionsDone}
>
  <div class="term-missions">
    <h3>{t.missionsLabel}</h3>
    <ol class="mission-list">
      {
        missions.map((m, i) => (
          <li class="mission" data-mission={m.id} data-active={i === 0 ? "true" : undefined}>
            <p class="mission-prompt">{m.prompt}</p>
            <details class="mission-hint">
              <summary aria-label="hint">?</summary>
              <p>{m.hint}</p>
            </details>
          </li>
        ))
      }
    </ol>
    <p class="mission-help">{t.helpHint}</p>
    <button class="term-reset-btn" id="py-reset" type="button">{t.reset}</button>
  </div>

  <div class="term-screen py-screen" id="py-screen">
    <div class="term-bar">
      <span class="term-dot"></span>
      <span class="term-dot"></span>
      <span class="term-dot"></span>
    </div>
    <textarea
      id="py-code"
      spellcheck="false"
      autocapitalize="off"
      autocomplete="off"
      aria-label="Python code"
      placeholder="rate = 150.0&#10;yen = 30000&#10;print(f&quot;{yen} JPY = {yen / rate} USD&quot;)"></textarea>
    <div class="py-runbar">
      <button class="py-run-btn" id="py-run" type="button">▶ {runLabel}</button>
    </div>
    <div class="term-output py-output" id="py-out"></div>
  </div>
</div>

<script>
  const app = document.getElementById("py-app")!;
  const out = document.getElementById("py-out")!;
  const codeArea = document.getElementById("py-code") as HTMLTextAreaElement;
  const runBtn = document.getElementById("py-run") as HTMLButtonElement;
  const resetBtn = document.getElementById("py-reset") as HTMLButtonElement;
  const missionEls = Array.from(app.querySelectorAll<HTMLElement>(".mission"));

  const missionCompleteTpl = app.dataset.missionComplete ?? "Mission {n} complete!";
  const missionsDoneMsg = app.dataset.missionsDone ?? "";

  /* ================= mini-python interpreter ================= */

  class PyError extends Error {
    name: string;
    lineNo: number | null;
    constructor(pyName: string, msg: string, lineNo: number | null = null) {
      super(msg);
      this.name = pyName;
      this.lineNo = lineNo;
    }
  }

  type Tok =
    | { t: "num"; v: number; isFloat: boolean }
    | { t: "str"; v: string }
    | { t: "fstr"; raw: string }
    | { t: "name"; v: string }
    | { t: "op"; v: string };

  function tokenize(src: string, lineNo: number): Tok[] {
    const toks: Tok[] = [];
    let i = 0;
    while (i < src.length) {
      const ch = src[i]!;
      if (/\s/.test(ch)) {
        i++;
        continue;
      }
      if (/[0-9]/.test(ch) || (ch === "." && /[0-9]/.test(src[i + 1] ?? ""))) {
        let j = i;
        while (j < src.length && /[0-9]/.test(src[j]!)) j++;
        let isFloat = false;
        if (src[j] === ".") {
          isFloat = true;
          j++;
          while (j < src.length && /[0-9]/.test(src[j]!)) j++;
        }
        if (src[j] === "e" || src[j] === "E") {
          isFloat = true;
          j++;
          if (src[j] === "-" || src[j] === "+") j++;
          while (j < src.length && /[0-9]/.test(src[j]!)) j++;
        }
        const text = src.slice(i, j);
        toks.push({ t: "num", v: Number(text), isFloat });
        i = j;
        continue;
      }
      if (ch === "f" && (src[i + 1] === '"' || src[i + 1] === "'")) {
        const quote = src[i + 1]!;
        let j = i + 2;
        while (j < src.length && src[j] !== quote) j++;
        if (j >= src.length) throw new PyError("SyntaxError", "unterminated f-string", lineNo);
        toks.push({ t: "fstr", raw: src.slice(i + 2, j) });
        i = j + 1;
        continue;
      }
      if (ch === '"' || ch === "'") {
        let j = i + 1;
        let val = "";
        while (j < src.length && src[j] !== ch) {
          if (src[j] === "\\") {
            const next = src[j + 1]!;
            val += next === "n" ? "\n" : next === "t" ? "\t" : next;
            j += 2;
          } else {
            val += src[j];
            j++;
          }
        }
        if (j >= src.length) throw new PyError("SyntaxError", "unterminated string", lineNo);
        toks.push({ t: "str", v: val });
        i = j + 1;
        continue;
      }
      if (/[A-Za-z_]/.test(ch)) {
        let j = i;
        while (j < src.length && /[A-Za-z0-9_]/.test(src[j]!)) j++;
        toks.push({ t: "name", v: src.slice(i, j) });
        i = j;
        continue;
      }
      const three = src.slice(i, i + 3);
      const two = src.slice(i, i + 2);
      if (two === "**" || two === "//" || two === "==" || two === "!=" || two === "<=" || two === ">=") {
        toks.push({ t: "op", v: two });
        i += 2;
        continue;
      }
      if ("+-*/%<>=().,:[]{}".includes(ch)) {
        toks.push({ t: "op", v: ch });
        i++;
        continue;
      }
      if (three === "...") {
        i += 3;
        continue;
      }
      throw new PyError("SyntaxError", `invalid character '${ch}'`, lineNo);
    }
    return toks;
  }

  /* strip comments outside of strings */
  function stripComment(line: string): string {
    let inStr: string | null = null;
    for (let i = 0; i < line.length; i++) {
      const ch = line[i]!;
      if (inStr) {
        if (ch === "\\") i++;
        else if (ch === inStr) inStr = null;
      } else if (ch === '"' || ch === "'") {
        inStr = ch;
      } else if (ch === "#") {
        return line.slice(0, i);
      }
    }
    return line;
  }

  /* ---------- statement AST ---------- */

  type Expr = any;
  interface Stmt {
    kind:
      | "assign"
      | "assignindex"
      | "expr"
      | "if"
      | "while"
      | "for"
      | "def"
      | "return"
      | "with"
      | "import"
      | "try";
    lineNo: number;
    name?: string;
    expr?: Expr;
    clauses?: { cond: Expr; body: Stmt[] }[];
    orelse?: Stmt[];
    cond?: Expr;
    body?: Stmt[];
    var?: string;
    iter?: Expr;
    params?: string[];
    idx?: Expr;
    openExpr?: Expr;
    handlers?: { name?: string; body: Stmt[] }[];
    finallyBody?: Stmt[];
  }

  function parseProgram(src: string): Stmt[] {
    const raw = src.split("\n");
    const lines: { indent: number; toks: Tok[]; lineNo: number }[] = [];
    raw.forEach((l, idx) => {
      const text = stripComment(l);
      if (!text.trim()) return;
      const indent = text.match(/^[ \t]*/)![0].replace(/\t/g, "    ").length;
      const toks = tokenize(text.trim(), idx + 1);
      if (toks.length) lines.push({ indent, toks, lineNo: idx + 1 });
    });
    if (lines.length === 0) return [];
    const [stmts] = parseBlock(lines, 0, lines[0]!.indent);
    return stmts;
  }

  function finishCondLine(
    parser: ExprParser,
    ln: { toks: Tok[]; lineNo: number },
    keyword: string,
  ): void {
    const ctok = parser.cur();
    if (!ctok || ctok.t !== "op" || ctok.v !== ":")
      throw new PyError(
        "SyntaxError",
        `expected ':' at the end of the ${keyword} line`,
        ln.lineNo,
      );
    parser.pos++;
    if (!parser.done())
      throw new PyError("SyntaxError", "invalid syntax", ln.lineNo);
  }

  function parseBlock(
    lines: { indent: number; toks: Tok[]; lineNo: number }[],
    start: number,
    indent: number,
  ): [Stmt[], number] {
    const stmts: Stmt[] = [];
    let i = start;
    while (i < lines.length && lines[i]!.indent === indent) {
      const ln = lines[i]!;
      const first = ln.toks[0]!;
      if (first.t === "name" && (first.v === "if" || first.v === "elif" || first.v === "else")) {
        const result = parseIf(lines, i, indent);
        stmts.push(result.stmt);
        i = result.next;
        continue;
      }
      if (first.t === "name" && first.v === "while") {
        const parser = new ExprParser(ln.toks.slice(1), ln.lineNo, true);
        const cond = parser.parseOr();
        finishCondLine(parser, ln, "while");
        const body = childBlock(lines, i + 1, indent, ln.lineNo);
        stmts.push({ kind: "while", lineNo: ln.lineNo, cond, body: body.stmts });
        i = body.next;
        continue;
      }
      if (first.t === "name" && first.v === "for") {
        const varTok = ln.toks[1];
        const inTok = ln.toks[2];
        if (!varTok || varTok.t !== "name" || !inTok || inTok.t !== "name" || inTok.v !== "in")
          throw new PyError(
            "SyntaxError",
            "expected: for variable in something:",
            ln.lineNo,
          );
        const parser = new ExprParser(ln.toks.slice(3), ln.lineNo, true);
        const iter = parser.parseOr();
        finishCondLine(parser, ln, "for");
        const body = childBlock(lines, i + 1, indent, ln.lineNo);
        stmts.push({
          kind: "for",
          lineNo: ln.lineNo,
          var: varTok.v,
          iter,
          body: body.stmts,
        });
        i = body.next;
        continue;
      }
      if (first.t === "name" && first.v === "def") {
        const nameTok = ln.toks[1];
        if (!nameTok || nameTok.t !== "name")
          throw new PyError("SyntaxError", "expected: def name(parameters):", ln.lineNo);
        if (ln.toks[2]?.t !== "op" || ln.toks[2].v !== "(")
          throw new PyError("SyntaxError", `expected '(' after ${nameTok.v}`, ln.lineNo);
        let j = 3;
        const params: string[] = [];
        while (ln.toks[j] && !(ln.toks[j].t === "op" && ln.toks[j].v === ")")) {
          const p = ln.toks[j]!;
          if (p.t === "name") params.push(p.v);
          else if (!(p.t === "op" && p.v === ","))
            throw new PyError("SyntaxError", "parameter names only, separated by commas", ln.lineNo);
          j++;
        }
        if (!ln.toks[j] || ln.toks[j]!.v !== ")")
          throw new PyError("SyntaxError", `expected ')' to close ${nameTok.v}(`, ln.lineNo);
        if (ln.toks[j + 1]?.t !== "op" || ln.toks[j + 1]!.v !== ":")
          throw new PyError(
            "SyntaxError",
            `expected ':' at the end of the def ${nameTok.v} line`,
            ln.lineNo,
          );
        if (ln.toks.length > j + 2)
          throw new PyError("SyntaxError", "invalid syntax", ln.lineNo);
        const body = childBlock(lines, i + 1, indent, ln.lineNo);
        stmts.push({
          kind: "def",
          lineNo: ln.lineNo,
          name: nameTok.v,
          params,
          body: body.stmts,
        });
        i = body.next;
        continue;
      }
      if (first.t === "name" && first.v === "with") {
        const asIdx = ln.toks.findIndex(
          (t, k) => k > 2 && t.t === "name" && t.v === "as",
        );
        if (asIdx === -1)
          throw new PyError(
            "SyntaxError",
            "expected: with open(file, mode) as variable:",
            ln.lineNo,
          );
        const openExpr = parseExprTokens(ln.toks.slice(1, asIdx), ln.lineNo, false);
        const varTok = ln.toks[asIdx + 1];
        if (!varTok || varTok.t !== "name")
          throw new PyError("SyntaxError", "expected a variable after 'as'", ln.lineNo);
        if (
          ln.toks[asIdx + 2]?.t !== "op" ||
          ln.toks[asIdx + 2]!.v !== ":" ||
          ln.toks.length > asIdx + 3
        )
          throw new PyError("SyntaxError", "expected ':' at the end of the with line", ln.lineNo);
        const body = childBlock(lines, i + 1, indent, ln.lineNo);
        stmts.push({ kind: "with", lineNo: ln.lineNo, openExpr, var: varTok.v, body: body.stmts });
        i = body.next;
        continue;
      }
      if (first.t === "name" && first.v === "import") {
        const mod = ln.toks[1];
        if (mod && mod.t === "name" && mod.v === "requests" && ln.toks.length === 2) {
          stmts.push({ kind: "import", lineNo: ln.lineNo, name: "requests" });
          i++;
          continue;
        }
        throw new PyError(
          "SimNote",
          `import ${mod?.v ?? ""} — this simulator provides only requests. The real csv and json modules are for the real project on your machine`,
          ln.lineNo,
        );
      }
      if (first.t === "name" && first.v === "try") {
        const t1 = ln.toks[1];
        if (ln.toks.length > 2 || !t1 || t1.t !== "op" || t1.v !== ":")
          throw new PyError("SyntaxError", "expected: try: then an indented block", ln.lineNo);
        const tryBody = childBlock(lines, i + 1, indent, ln.lineNo);
        let next = tryBody.next;
        const handlers: { name?: string; body: Stmt[] }[] = [];
        let finallyBody: Stmt[] | undefined;
        while (next < lines.length && lines[next]!.indent === indent) {
          const hl = lines[next]!;
          const ht = hl.toks[0]!;
          if (ht.t !== "name" || (ht.v !== "except" && ht.v !== "finally")) break;
          if (ht.v === "finally") {
            const ft = hl.toks[1];
            if (hl.toks.length > 2 || !ft || ft.t !== "op" || ft.v !== ":")
              throw new PyError("SyntaxError", "expected: finally: then an indented block", hl.lineNo);
            const fb = childBlock(lines, next + 1, indent, hl.lineNo);
            finallyBody = fb.stmts;
            next = fb.next;
            break;
          }
          // except: | except SomeError:
          const t1 = hl.toks[1];
          if (!t1 || (t1.t === "op" && t1.v === ":")) {
            if (hl.toks.length > 2)
              throw new PyError("SyntaxError", "invalid syntax", hl.lineNo);
          } else if (t1.t === "name") {
            if (hl.toks[2]?.t !== "op" || hl.toks[2]!.v !== ":")
              throw new PyError(
                "SyntaxError",
                `expected ':' after except ${t1.v}`,
                hl.lineNo,
              );
            if (hl.toks.length > 3)
              throw new PyError("SyntaxError", "invalid syntax", hl.lineNo);
          } else {
            throw new PyError("SyntaxError", "expected: except: or except ErrorName:", hl.lineNo);
          }
          const hb = childBlock(lines, next + 1, indent, hl.lineNo);
          handlers.push({ name: t1 && t1.t === "name" ? t1.v : undefined, body: hb.stmts });
          next = hb.next;
        }
        stmts.push({
          kind: "try",
          lineNo: ln.lineNo,
          body: tryBody.stmts,
          handlers,
          finallyBody,
        });
        i = next;
        continue;
      }
      if (first.t === "name" && first.v === "return") {
        const rest = ln.toks.slice(1);
        stmts.push({
          kind: "return",
          lineNo: ln.lineNo,
          expr: rest.length ? parseExprTokens(rest, ln.lineNo, false) : null,
        });
        i++;
        continue;
      }
      stmts.push(parseSimple(ln));
      i++;
    }
    if (i < lines.length && lines[i]!.indent > indent) {
      throw new PyError("IndentationError", "unexpected indent", lines[i]!.lineNo);
    }
    return [stmts, i];
  }

  function parseIf(
    lines: { indent: number; toks: Tok[]; lineNo: number }[],
    i: number,
    indent: number,
  ): { stmt: Stmt; next: number } {
    const clauses: { cond: Expr; body: Stmt[] }[] = [];
    let orelse: Stmt[] | undefined;
    let next = i;
    while (next < lines.length && lines[next]!.indent === indent) {
      const ln = lines[next]!;
      const first = ln.toks[0]!;
      if (!(first.t === "name" && (first.v === "if" || first.v === "elif" || first.v === "else")))
        break;
      if (first.v === "else") {
        if (ln.toks[1]?.t !== "op" || ln.toks[1]!.v !== ":")
          throw new PyError("SyntaxError", "expected ':' after else", ln.lineNo);
        if (ln.toks.length > 2)
          throw new PyError("SyntaxError", "else: cannot have a condition — use elif", ln.lineNo);
        const body = childBlock(lines, next + 1, indent, ln.lineNo);
        orelse = body.stmts;
        next = body.next;
        break;
      }
      const parser = new ExprParser(ln.toks.slice(1), ln.lineNo, true);
      const cond = parser.parseOr();
      const ctok = parser.cur();
      if (!ctok || ctok.t !== "op" || ctok.v !== ":")
        throw new PyError(
          "SyntaxError",
          `expected ':' at the end of the ${first.v} line`,
          ln.lineNo,
        );
      parser.pos++;
      if (!parser.done())
        throw new PyError("SyntaxError", "invalid syntax", ln.lineNo);
      const body = childBlock(lines, next + 1, indent, ln.lineNo);
      clauses.push({ cond, body: body.stmts });
      next = body.next;
    }
    if (clauses.length === 0) throw new PyError("SyntaxError", "invalid syntax");
    return { stmt: { kind: "if", lineNo: lines[i]!.lineNo, clauses, orelse }, next };
  }

  function childBlock(
    lines: { indent: number; toks: Tok[]; lineNo: number }[],
    i: number,
    parentIndent: number,
    lineNo: number,
  ): { stmts: Stmt[]; next: number } {
    if (i >= lines.length || lines[i]!.indent <= parentIndent) {
      throw new PyError("IndentationError", "expected an indented block", lineNo);
    }
    const [stmts, next] = parseBlock(lines, i, lines[i]!.indent);
    return { stmts, next };
  }

  function parseSimple(ln: { toks: Tok[]; lineNo: number }): Stmt {
    const toks = ln.toks;
    // dict/list element assignment: expenses[0] = "x", d["k"] = v
    if (toks[0]?.t === "name" && toks[1]?.t === "op" && toks[1].v === "[") {
      const close = toks.findIndex((t, k) => k > 1 && t.t === "op" && t.v === "]");
      if (close !== -1 && toks[close + 1]?.t === "op" && toks[close + 1]!.v === "=") {
        return {
          kind: "assignindex",
          lineNo: ln.lineNo,
          name: toks[0].v,
          idx: parseExprTokens(toks.slice(2, close), ln.lineNo, false),
          expr: parseExprTokens(toks.slice(close + 2), ln.lineNo, false),
        };
      }
    }
    if (toks[1] && toks[1].t === "op" && toks[1].v === "=") {
      if (toks[0].t !== "name")
        throw new PyError("SyntaxError", "cannot assign to this", ln.lineNo);
      if (toks.length > 2 && toks[2].t === "op" && toks[2].v === "=")
        throw new PyError("SyntaxError", "invalid syntax — use == to compare", ln.lineNo);
      return {
        kind: "assign",
        lineNo: ln.lineNo,
        name: toks[0].v,
        expr: parseExprTokens(toks.slice(2), ln.lineNo, false),
      };
    }
    // augmented assignment: x += 1, x -= 1, x *= 2, x /= 2
    if (
      toks[0]?.t === "name" &&
      toks[1]?.t === "op" &&
      ["+", "-", "*", "/"].includes(toks[1].v) &&
      toks[2]?.t === "op" &&
      toks[2].v === "="
    ) {
      return {
        kind: "assign",
        lineNo: ln.lineNo,
        name: toks[0].v,
        expr: {
          k: "bin",
          op: toks[1].v,
          left: { k: "name", v: toks[0].v },
          right: parseExprTokens(toks.slice(3), ln.lineNo, false),
        },
      };
    }
    return { kind: "expr", lineNo: ln.lineNo, expr: parseExprTokens(toks, ln.lineNo, false) };
  }

  /* ---------- expression parser (precedence climbing) ---------- */

  function parseExprTokens(toks: Tok[], lineNo: number, stopAtColon: boolean): Expr {
    const p = new ExprParser(toks, lineNo, stopAtColon);
    const e = p.parseOr();
    if (!p.done()) throw new PyError("SyntaxError", "invalid syntax", lineNo);
    return e;
  }

  class ExprParser {
    toks: Tok[];
    pos = 0;
    lineNo: number;
    stopAtColon: boolean;
    constructor(toks: Tok[], lineNo: number, stopAtColon: boolean) {
      this.toks = toks;
      this.lineNo = lineNo;
      this.stopAtColon = stopAtColon;
    }
    cur(): Tok {
      return this.toks[this.pos]!;
    }
    isOp(v: string): boolean {
      const c = this.cur();
      return !!c && c.t === "op" && c.v === v;
    }
    eat(v: string) {
      if (!this.isOp(v)) throw new PyError("SyntaxError", "invalid syntax", this.lineNo);
      this.pos++;
    }
    done(): boolean {
      const c = this.cur();
      if (!c) return true;
      if (this.stopAtColon && c.t === "op" && c.v === ":") return true;
      return false;
    }
    parseOr(): Expr {
      let left = this.parseAnd();
      while (this.cur()?.t === "name" && this.cur().v === "or") {
        this.pos++;
        left = { k: "bool", op: "or", left, right: this.parseAnd() };
      }
      return left;
    }
    parseAnd(): Expr {
      let left = this.parseNot();
      while (this.cur()?.t === "name" && this.cur().v === "and") {
        this.pos++;
        left = { k: "bool", op: "and", left, right: this.parseNot() };
      }
      return left;
    }
    parseNot(): Expr {
      if (this.cur()?.t === "name" && this.cur().v === "not") {
        this.pos++;
        return { k: "not", operand: this.parseNot() };
      }
      return this.parseCompare();
    }
    parseCompare(): Expr {
      let left = this.parseArith();
      const ops = ["==", "!=", "<", "<=", ">", ">="];
      const c = this.cur();
      if (c && c.t === "op" && ops.includes(c.v)) {
        this.pos++;
        const right = this.parseArith();
        left = { k: "cmp", op: c.v, left, right };
      } else if (c && c.t === "name" && c.v === "in") {
        this.pos++;
        left = { k: "cmp", op: "in", left, right: this.parseArith() };
      } else if (
        c &&
        c.t === "name" &&
        c.v === "not" &&
        this.toks[this.pos + 1]?.t === "name" &&
        this.toks[this.pos + 1]!.v === "in"
      ) {
        this.pos += 2;
        left = { k: "cmp", op: "not in", left, right: this.parseArith() };
      }
      return left;
    }
    parseArith(): Expr {
      let left = this.parseTerm();
      while (this.isOp("+") || this.isOp("-")) {
        const op = this.cur().v;
        this.pos++;
        left = { k: "bin", op, left, right: this.parseTerm() };
      }
      return left;
    }
    parseTerm(): Expr {
      let left = this.parseUnary();
      while (this.isOp("*") || this.isOp("/") || this.isOp("//") || this.isOp("%")) {
        const op = this.cur().v;
        this.pos++;
        left = { k: "bin", op, left, right: this.parseUnary() };
      }
      return left;
    }
    parseUnary(): Expr {
      if (this.isOp("-")) {
        this.pos++;
        return { k: "neg", operand: this.parseUnary() };
      }
      if (this.isOp("+")) {
        this.pos++;
        return this.parseUnary();
      }
      return this.parsePower();
    }
    parsePower(): Expr {
      const base = this.parsePostfix();
      if (this.isOp("**")) {
        this.pos++;
        return { k: "bin", op: "**", left: base, right: this.parseUnary() };
      }
      return base;
    }
    parsePostfix(): Expr {
      let node = this.parseAtom();
      for (;;) {
        if (this.isOp("(")) {
          this.pos++;
          const args: Expr[] = [];
          while (!this.isOp(")")) {
            args.push(this.parseOr());
            if (this.isOp(",")) this.pos++;
            else break;
          }
          this.eat(")");
          node = { k: "call", func: node, args };
          continue;
        }
        if (this.isOp(".")) {
          this.pos++;
          const c = this.cur();
          if (!c || c.t !== "name")
            throw new PyError("SyntaxError", "invalid syntax", this.lineNo);
          this.pos++;
          node = { k: "method", obj: node, name: c.v };
          continue;
        }
        if (this.isOp("[")) {
          this.pos++;
          const c = this.cur();
          let lo: Expr | null = null;
          let hi: Expr | null = null;
          if (!this.isOp(":")) lo = this.parseOr();
          if (this.isOp(":")) {
            this.pos++;
            if (!this.isOp("]")) hi = this.parseOr();
            node = { k: "slice", obj: node, lo, hi };
          } else {
            if (lo === null)
              throw new PyError("SyntaxError", "invalid syntax", this.lineNo);
            node = { k: "index", obj: node, idx: lo };
          }
          this.eat("]");
          continue;
        }
        break;
      }
      return node;
    }
    parseAtom(): Expr {
      const c = this.cur();
      if (!c) throw new PyError("SyntaxError", "invalid syntax", this.lineNo);
      if (c.t === "num") {
        this.pos++;
        return { k: "num", v: c.v };
      }
      if (c.t === "str") {
        this.pos++;
        return { k: "str", v: c.v };
      }
      if (c.t === "fstr") {
        this.pos++;
        return { k: "fstr", raw: c.raw };
      }
      if (c.t === "name") {
        this.pos++;
        if (c.v === "True") return { k: "const", v: true };
        if (c.v === "False") return { k: "const", v: false };
        if (c.v === "None") return { k: "const", v: null };
        return { k: "name", v: c.v };
      }
      if (c.t === "op" && c.v === "(") {
        this.pos++;
        const e = this.parseOr();
        this.eat(")");
        return e;
      }
      if (c.t === "op" && c.v === "[") {
        this.pos++;
        const items: Expr[] = [];
        while (!this.isOp("]")) {
          items.push(this.parseOr());
          if (this.isOp(",")) this.pos++;
          else break;
        }
        this.eat("]");
        return { k: "list", items };
      }
      if (c.t === "op" && c.v === "{") {
        this.pos++;
        const pairs: { key: Expr; value: Expr }[] = [];
        while (!this.isOp("}")) {
          const key = this.parseOr();
          if (this.isOp(":")) {
            this.pos++;
            const value = this.parseOr();
            pairs.push({ key, value });
          } else {
            throw new PyError("SyntaxError", "dict needs key: value pairs", this.lineNo);
          }
          if (this.isOp(",")) this.pos++;
          else break;
        }
        this.eat("}");
        return { k: "dict", pairs };
      }
      throw new PyError("SyntaxError", "invalid syntax", this.lineNo);
    }
  }

  /* ---------- evaluation ---------- */

  type Val = number | string | boolean | null | any[] | { __func: any; __name?: string };

  let runPrinted: string[] = [];

  function pyRepr(v: Val): string {
    if (typeof v === "string") return `'${v}'`;
    return pyStr(v);
  }

  function pyStr(v: Val): string {
    if (typeof v === "boolean") return v ? "True" : "False";
    if (v === null) return "None";
    if (typeof v === "number") return String(v);
    if (Array.isArray(v)) return `[${v.map((x) => pyRepr(x as Val)).join(", ")}]`;
    if (typeof v === "object" && "__func" in v) return `<function ${(v as any).__name}>`;
    if (typeof v === "object" && "__file" in v) {
      const f = (v as any).__file;
      return `<file '${f.path}' (mode '${f.mode}')>`;
    }
    if (typeof v === "object" && "__response" in v)
      return `<Response [${(v as any).__response.status_code}]>`;
    if (typeof v === "object" && "__module" in v)
      return `<module '${(v as any).__module}'>`;
    if (typeof v === "object") {
      const entries = Object.entries(v).map(
        ([k, val]) => `${pyRepr(k as Val)}: ${pyRepr(val as Val)}`,
      );
      return `{${entries.join(", ")}}`;
    }
    return String(v);
  }

  function pyTruth(v: Val): boolean {
    if (v === null || v === false) return false;
    if (v === true) return true;
    if (typeof v === "number") return v !== 0;
    if (typeof v === "string") return v.length > 0;
    if (Array.isArray(v)) return v.length > 0;
    if (typeof v === "object") return Object.keys(v).length > 0;
    return true;
  }

  function typeName(v: Val): string {
    if (typeof v === "boolean") return "bool";
    if (v === null) return "NoneType";
    if (typeof v === "number")
      return Number.isInteger(v) ? "int" : "float";
    if (Array.isArray(v)) return "list";
    if (typeof v === "object" && "__func" in v) return "function";
    if (typeof v === "object" && "__range" in v) return "range";
    if (typeof v === "object" && "__file" in v) return "file";
    if (typeof v === "object" && "__response" in v) return "Response";
    if (typeof v === "object" && "__module" in v) return "module";
    if (typeof v === "object") return "dict";
    return "str";
  }

  function applyMethod(obj: Val, name: string, args: Val[]): Val {
    /* modules (requests) */
    if (obj && typeof obj === "object" && "__module" in obj) {
      if ((obj as any).__module === "requests" && name === "get") {
        const url = args[0];
        if (typeof url !== "string")
          throw new PyError("TypeError", "requests.get() needs a URL string");
        return fakeGet(url);
      }
      throw new PyError(
        "AttributeError",
        `module 'requests' supports get(url) — not '${name}' in this simulator`,
      );
    }
    /* HTTP responses */
    if (obj && typeof obj === "object" && "__response" in obj) {
      const r = (obj as any).__response;
      if (name === "status_code") return r.status_code;
      if (name === "json") return JSON.parse(JSON.stringify(r.body));
      if (name === "raise_for_status") {
        if (r.status_code >= 400)
          throw new PyError("HTTPError", `${r.status_code} Error for url '${r.url}'`);
        return null;
      }
      throw new PyError(
        "AttributeError",
        "response objects support .status_code .json() .raise_for_status()",
      );
    }
    /* file handles */
    if (obj && typeof obj === "object" && "__file" in obj) {
      const f = (obj as any).__file;
      if (name === "write") {
        if (typeof args[0] !== "string")
          throw new PyError("TypeError", "write() needs a string");
        if (f.mode === "r")
          throw new PyError(
        "io.UnsupportedOperation",
            "io.UnsupportedOperation: file opened 'r' — not writable (open with \"w\" to write)",
          );
        simFiles[f.path] = (simFiles[f.path] ?? "") + args[0];
        persistFiles();
        f.content = simFiles[f.path];
        return null;
      }
      if (name === "read") {
        if (f.mode !== "r")
          throw new PyError(
        "io.UnsupportedOperation",
            "io.UnsupportedOperation: file opened for writing — not readable (open with \"r\" to read)",
          );
        codeFlags.add("fileread");
        return f.content;
      }
      if (name === "readlines") {
        if (f.mode !== "r")
          throw new PyError(
        "io.UnsupportedOperation", "io.UnsupportedOperation: not readable");
        codeFlags.add("fileread");
        return f.content.split("\n").filter((l: string) => l.length > 0);
      }
      if (name === "close") return null;
      throw new PyError(
        "AttributeError",
        `file objects support write() / read() / readlines() / close() — not '${name}'`,
      );
    }
    /* dicts */
    if (obj && typeof obj === "object" && !Array.isArray(obj) && !("__func" in obj)) {
      const d = obj as Record<string, any>;
      if (name === "get") {
        const key = String(args[0]);
        return key in d ? d[key] : (args.length > 1 ? args[1] : null);
      }
      if (name === "keys") return Object.keys(d);
      if (name === "values") return Object.values(d);
      if (name === "items") return Object.entries(d).map(([k, v]) => [k, v]);
      throw new PyError(
        "AttributeError",
        `dicts support .get() .keys() .values() .items() — not '${name}'`,
      );
    }
    if (Array.isArray(obj)) {
      if (name === "append") {
        if (args.length !== 1)
          throw new PyError("TypeError", "append() takes exactly one argument");
        obj.push(args[0]!);
        return null;
      }
      throw new PyError(
        "AttributeError",
        `this simulator supports .append() on lists — '${name}' comes later`,
      );
    }
    if (typeof obj !== "string")
      throw new PyError(
        "AttributeError",
        `'${typeName(obj)}' object has no attribute '${name}'`,
      );
    switch (name) {
      case "upper":
        return obj.toUpperCase();
      case "lower":
        return obj.toLowerCase();
      case "strip":
        return obj.trim();
      case "capitalize":
        return obj.charAt(0).toUpperCase() + obj.slice(1).toLowerCase();
      case "title":
        return obj
          .toLowerCase()
          .split(" ")
          .map((w) => (w ? w[0]!.toUpperCase() + w.slice(1) : w))
          .join(" ");
      case "replace": {
        if (args.length !== 2)
          throw new PyError("TypeError", "replace() takes exactly 2 arguments");
        return obj.split(String(args[0])).join(String(args[1]));
      }
      case "split": {
        if (args.length > 1)
          throw new PyError("TypeError", "split() takes at most 1 argument");
        if (args.length === 1) return obj.split(String(args[0]));
        return obj.trim().split(/\s+/).filter((w) => w.length > 0);
      }
      case "join": {
        const sep = args[0];
        if (!Array.isArray(sep))
          throw new PyError("TypeError", "join() needs a list of strings");
        if (!sep.every((x) => typeof x === "string"))
          throw new PyError("TypeError", "join() needs a list of strings");
        return sep.join(obj);
      }
    }
    throw new PyError(
      "AttributeError",
      `this simulator supports .upper() .lower() .strip() .title() .capitalize() .replace(a, b) — '${name}' comes later`,
    );
  }

  function evalExpr(e: Expr, env: Record<string, Val>, flags: Set<string>): Val {
    switch (e.k) {
      case "num":
      case "str":
      case "const":
        return e.v;
      case "name": {
        if (!(e.v in env))
          throw new PyError("NameError", `name '${e.v}' is not defined`);
        return env[e.v]!;
      }
      case "list": {
        return e.items.map((it: Expr) => evalExpr(it, env, flags));
      }
      case "dict": {
        const d: Record<string, any> = {};
        for (const p of e.pairs) {
          d[pyStr(evalExpr(p.key, env, flags))] = evalExpr(p.value, env, flags);
        }
        return d;
      }
      case "neg": {
        const v = evalExpr(e.operand, env, flags);
        if (typeof v !== "number")
          throw new PyError("TypeError", `bad operand type for unary -: '${typeName(v)}'`);
        return -v;
      }
      case "bool": {
        const l = evalExpr(e.left, env, flags);
        if (e.op === "and") return pyTruth(l) ? evalExpr(e.right, env, flags) : l;
        return pyTruth(l) ? l : evalExpr(e.right, env, flags);
      }
      case "not":
        return !pyTruth(evalExpr(e.operand, env, flags));
      case "cmp": {
        const l = evalExpr(e.left, env, flags);
        const r = evalExpr(e.right, env, flags);
        switch (e.op) {
          case "==":
            return l === r;
          case "!=":
            return l !== r;
          case "in":
          case "not in": {
            let found = false;
            if (typeof r === "string") found = typeof l === "string" && r.includes(l);
            else if (Array.isArray(r)) found = r.some((x) => x === l);
            else if (r && typeof r === "object" && !Array.isArray(r))
              found = String(l) in r;
            else
              throw new PyError(
                "TypeError",
                `argument of type '${typeName(r)}' is not iterable`,
              );
            return e.op === "in" ? found : !found;
          }
        }
        if (typeof l !== typeof r)
          throw new PyError(
            "TypeError",
            `'${e.op}' not supported between instances of '${typeName(l)}' and '${typeName(r)}'`,
          );
        switch (e.op) {
          case "<":
            return (l as any) < (r as any);
          case "<=":
            return (l as any) <= (r as any);
          case ">":
            return (l as any) > (r as any);
          case ">=":
            return (l as any) >= (r as any);
        }
        throw new PyError("SyntaxError", "invalid syntax");
      }
      case "bin": {
        const l = evalExpr(e.left, env, flags);
        const r = evalExpr(e.right, env, flags);
        if (e.op === "+") {
          if (typeof l === "number" && typeof r === "number") return l + r;
          if (typeof l === "string" && typeof r === "string") return l + r;
          if (Array.isArray(l) && Array.isArray(r)) return [...l, ...r];
          if (typeof l === "string")
            throw new PyError(
              "TypeError",
              `can only concatenate str (not "${typeName(r)}") to str`,
            );
          throw new PyError(
            "TypeError",
            `unsupported operand type(s) for +: '${typeName(l)}' and '${typeName(r)}'`,
          );
        }
        if (e.op === "*") {
          if (typeof l === "number" && typeof r === "number") return l * r;
          if (typeof l === "string" && typeof r === "number")
            return l.repeat(Math.max(0, r));
          if (typeof l === "number" && typeof r === "string")
            return r.repeat(Math.max(0, l));
          throw new PyError(
            "TypeError",
            `can't multiply sequence by non-int of type '${typeName(r)}'`,
          );
        }
        if (typeof l !== "number" || typeof r !== "number")
          throw new PyError(
            "TypeError",
            `unsupported operand type(s) for ${e.op}: '${typeName(l)}' and '${typeName(r)}'`,
          );
        if ((e.op === "/" || e.op === "//") && r === 0)
          throw new PyError("ZeroDivisionError", "division by zero");
        switch (e.op) {
          case "/":
            return l / r;
          case "//":
            return Math.floor(l / r);
          case "%":
            return ((l % r) + r) % r;
          case "**":
            return Math.pow(l, r);
        }
        throw new PyError("SyntaxError", "invalid syntax");
      }
      case "fstr": {
        flags.add("fstr");
        let result = "";
        let i = 0;
        const raw: string = e.raw;
        while (i < raw.length) {
          if (raw[i] === "{") {
            if (raw[i + 1] === "{") {
              result += "{";
              i += 2;
              continue;
            }
            let j = i + 1;
            let depth = 1;
            let specIdx = -1;
            while (j < raw.length) {
              const ch = raw[j];
              if (ch === "{") depth++;
              else if (ch === "}") {
                depth--;
                if (depth === 0) break;
              } else if (ch === ":" && depth === 1 && specIdx === -1) {
                specIdx = j;
              }
              j++;
            }
            if (depth !== 0)
              throw new PyError("SyntaxError", "unterminated f-string expression");
            const endExpr = specIdx !== -1 ? specIdx : j;
            const exprSrc = raw.slice(i + 1, endExpr);
            const spec = specIdx !== -1 ? raw.slice(specIdx + 1, j) : "";
            if (!exprSrc.trim())
              throw new PyError("SyntaxError", "f-string: empty expression");
            const subToks = tokenize(exprSrc, 0);
            const sub = parseExprTokens(subToks, 0, false);
            const v = evalExpr(sub, env, flags);
            if (spec && /^\.\d+f$/.test(spec)) {
              result += Number(v).toFixed(Number(spec.slice(1, -1)));
            } else if (spec) {
              throw new PyError(
                "SimNote",
                `format spec ':${spec}' — this simulator supports only .Nf (decimals)`,
              );
            } else {
              result += pyStr(v as Val);
            }
            i = j + 1;
            continue;
          }
          if (raw[i] === "}" && raw[i + 1] === "}") {
            result += "}";
            i += 2;
            continue;
          }
          result += raw[i];
          i++;
        }
        return result;
      }
      case "call": {
        if (e.func.k === "method") {
          const obj = evalExpr(e.func.obj, env, flags);
          const margs = e.args.map((a: Expr) => evalExpr(a, env, flags));
          return applyMethod(obj, e.func.name, margs);
        }
        const fname = e.func.k === "name" ? e.func.v : null;
        const args = e.args.map((a: Expr) => evalExpr(a, env, flags));
        if (fname === "print") {
          runPrinted.push(args.map((a: Val) => pyStr(a)).join(" "));
          return null;
        }
        if (fname === "range") {
          if (args.length < 1 || args.length > 3)
            throw new PyError("TypeError", "range() takes 1 to 3 arguments");
          if (!args.every((a: Val) => typeof a === "number" && Number.isInteger(a)))
            throw new PyError("TypeError", "range() needs integers");
          const a = args.length === 1 ? 0 : (args[0] as number);
          const b = args.length === 1 ? (args[0] as number) : (args[1] as number);
          const step = args.length === 3 ? (args[2] as number) : 1;
          if (step === 0) throw new PyError("ValueError", "range() arg 3 must not be zero");
          return { __range: { a, b, step } } as any;
        }
        if (fname === "int") {
          const a = args[0] as Val;
          if (typeof a === "number") return Math.trunc(a);
          if (typeof a === "string") {
            const t = a.trim();
            if (/^-?\d+$/.test(t)) return Number(t);
            throw new PyError(
              "ValueError",
              `invalid literal for int() with base 10: '${a}'`,
            );
          }
          if (typeof a === "boolean") return a ? 1 : 0;
          throw new PyError("TypeError", "int() argument must be a string or a number");
        }
        if (fname === "float") {
          const a = args[0] as Val;
          if (typeof a === "number") return a;
          if (typeof a === "string") {
            const t = a.trim();
            if (/^-?\d+(\.\d+)?$/.test(t)) return Number(t);
            throw new PyError("ValueError", `could not convert string to float: '${a}'`);
          }
          throw new PyError("TypeError", "float() argument must be a string or a number");
        }
        if (fname === "str") return pyStr(args[0] as Val);
        if (fname === "len") {
          const a = args[0] as Val;
          if (typeof a === "string") return a.length;
          if (Array.isArray(a)) return a.length;
          if (a && typeof a === "object" && !("__func" in a))
            return Object.keys(a).length;
          throw new PyError("TypeError", `object of type '${typeName(a)}' has no len()`);
        }
        if (fname === "open") {
          const path = args[0];
          const mode = args.length > 1 ? args[1] : "r";
          if (typeof path !== "string" || typeof mode !== "string")
            throw new PyError("TypeError", "open() needs a file name and a mode string");
          if (!["r", "w", "a"].includes(mode))
            throw new PyError(
              "ValueError",
              `invalid mode: '${mode}' — this simulator supports r, w, a`,
            );
          if (mode === "r" && !(path in simFiles))
            throw new PyError(
              "FileNotFoundError",
              `[Errno 2] No such file or directory: '${path}'`,
            );
          if (mode === "w") {
            simFiles[path] = "";
            persistFiles();
          }
          return {
            __file: {
              path,
              mode,
              content: mode === "w" ? "" : (simFiles[path] ?? ""),
            },
          } as any;
        }
        if (fname === "round") {
          const a = args[0] as Val;
          if (typeof a !== "number") throw new PyError("TypeError", "round() needs a number");
          const n = args.length > 1 ? (args[1] as number) : 0;
          const f = Math.pow(10, n);
          return Math.round(a * f) / f;
        }
        if (fname === "abs") {
          const a = args[0] as Val;
          if (typeof a !== "number") throw new PyError("TypeError", "abs() needs a number");
          return Math.abs(a);
        }
        if (fname === "input") {
          throw new PyError(
            "SimNote",
            "input() needs a human — in this simulator, assign values directly (rate = 150.0)",
          );
        }
        // user-defined functions
        if (fname !== null && fname in env) {
          const f = env[fname] as any;
          if (f && typeof f === "object" && "__func" in f) {
            const expected = f.__func.params.length;
            if (args.length !== expected)
              throw new PyError(
                "TypeError",
                `${fname}() takes exactly ${expected} argument${expected === 1 ? "" : "s"} (${args.length} given)`,
              );
            const localEnv = Object.create(env) as Record<string, Val>;
            f.__func.params.forEach((p: string, idx: number) => {
              localEnv[p] = args[idx]!;
            });
            try {
              runStmts(f.__func.body, localEnv, flags);
            } catch (err: any) {
              if (err && err.__return !== undefined) return err.__return;
              throw err;
            }
            return null;
          }
          if (typeof f === "string" || typeof f === "number") {
            throw new PyError(
              "TypeError",
              `'${fname}' is a variable, not a function — did you mean print(${fname})?`,
            );
          }
        }
        throw new PyError("NameError", `name '${fname ?? "expression"}' is not defined`);
      }
      case "method": {
        const obj = evalExpr(e.obj, env, flags);
        return applyMethod(obj, e.name, []);
      }
      case "index": {
        const obj = evalExpr(e.obj, env, flags);
        const idx = evalExpr(e.idx, env, flags);
        if (typeof obj === "string" && typeof idx === "number") {
          const i2 = idx < 0 ? obj.length + idx : idx;
          if (i2 < 0 || i2 >= obj.length)
            throw new PyError("IndexError", "string index out of range");
          return obj[i2]!;
        }
        if (Array.isArray(obj) && typeof idx === "number" && Number.isInteger(idx)) {
          const i2 = idx < 0 ? obj.length + idx : idx;
          if (i2 < 0 || i2 >= obj.length)
            throw new PyError("IndexError", "list index out of range");
          return obj[i2] as Val;
        }
        if (obj && typeof obj === "object" && !Array.isArray(obj) && !("__func" in obj)) {
          const key = String(idx);
          if (!(key in obj))
            throw new PyError("KeyError", `'${key}'`);
          return obj[key]!;
        }
        throw new PyError(
          "TypeError",
          "strings, lists and dicts can be indexed in this simulator",
        );
      }
      case "slice": {
        const obj = evalExpr(e.obj, env, flags);
        const items = typeof obj === "string" ? obj.split("") : obj;
        if (!Array.isArray(items) && typeof items !== "string")
          throw new PyError("TypeError", "only strings and lists can be sliced in this simulator");
        const n = items.length;
        const lo = e.lo ? (evalExpr(e.lo, env, flags) as number) : 0;
        const hi = e.hi ? (evalExpr(e.hi, env, flags) as number) : n;
        const lo2 = lo < 0 ? n + lo : lo;
        const hi2 = hi < 0 ? n + hi : hi;
        const part = items.slice(Math.max(0, lo2), Math.max(0, hi2));
        return typeof obj === "string" ? (part as string[]).join("") : (part as Val[]);
      }
    }
    throw new PyError("SyntaxError", "invalid syntax");
  }

  /* values ever assigned to each variable, across all runs — lets missions
     pass even when the program later changes a variable (like yen) */
  let envSeen: Record<string, Set<string>> = {};
  let loopBudget = 10000;

  /* fake file system — persists between runs via localStorage */
  let simFiles: Record<string, string> = {};
  try {
    simFiles = JSON.parse(
      (globalThis as any).localStorage?.getItem?.("msa-py-files") ?? "{}",
    );
  } catch {}
  function persistFiles(): void {
    try {
      (globalThis as any).localStorage?.setItem?.(
        "msa-py-files",
        JSON.stringify(simFiles),
      );
    } catch {}
  }

  /* fake internet — requests.get() against a small registry of endpoints */
  let flakyCalls = 0;

  function fakeGet(url: string): any {
    const endpoints: Record<string, () => { status_code: number; body: any }> = {
      "https://api.frankfurter.app/latest?from=USD&to=JPY": () => ({
        status_code: 200,
        body: { amount: 1.0, base: "USD", date: "2026-10-15", rates: { JPY: 149.98 } },
      }),
      "https://api.frankfurter.app/latest?from=EUR&to=JPY": () => ({
        status_code: 200,
        body: { amount: 1.0, base: "EUR", date: "2026-10-15", rates: { JPY: 163.55 } },
      }),
      "https://api.frankfurter.app/flaky": () => {
        flakyCalls++;
        if (flakyCalls <= 1)
          return { status_code: 500, body: { error: "upstream timeout" } };
        return {
          status_code: 200,
          body: { amount: 1.0, base: "USD", date: "2026-10-15", rates: { JPY: 150.01 } },
        };
      },
    };
    const hit = (endpoints[url] ?? (() => ({ status_code: 404, body: { error: "not found" } })))();
    return { __response: { url, ...hit } };
  }

  function runStmts(stmts: Stmt[], env: Record<string, Val>, flags: Set<string>): void {
    for (const st of stmts) {
      let res;
      if (st.kind === "assign") {
        const v = evalExpr(st.expr!, env, flags);
        env[st.name!] = v;
        (envSeen[st.name!] ??= new Set()).add(pyStr(v));
        continue;
      }
      if (st.kind === "if") {
        for (const cl of st.clauses!) {
          if (pyTruth(evalExpr(cl.cond, env, flags))) {
            flags.add("if");
            runStmts(cl.body, env, flags);
            res = true;
            break;
          }
        }
        if (!res && st.orelse) {
          flags.add("if");
          runStmts(st.orelse, env, flags);
        }
        continue;
      }
      if (st.kind === "while") {
        flags.add("while");
        for (;;) {
          if (loopBudget <= 0)
            throw new PyError(
              "SimNote",
              "this loop ran 10000 times — it looks infinite. In a while loop, something inside must change the condition (e.g. i = i + 1)",
              st.lineNo,
            );
          if (!pyTruth(evalExpr(st.cond!, env, flags))) break;
          loopBudget--;
          runStmts(st.body!, env, flags);
        }
        continue;
      }
      if (st.kind === "for") {
        flags.add("for");
        const it = evalExpr(st.iter!, env, flags);
        let values: Val[] = [];
        if (it !== null && typeof it === "object" && "__range" in (it as object)) {
          const r = (it as any).__range;
          for (let n = r.a; r.step > 0 ? n < r.b : n > r.b; n += r.step) values.push(n);
        } else if (typeof it === "string") {
          values = it.split("");
        } else if (Array.isArray(it)) {
          values = [...it];
        } else if (it && typeof it === "object" && !("__func" in it)) {
          values = Object.keys(it);
        } else {
          throw new PyError("TypeError", `'${typeName(it)}' object is not iterable`, st.lineNo);
        }
        for (const v of values) {
          if (loopBudget-- <= 0)
            throw new PyError(
              "SimNote",
              "this loop ran 10000 times — it looks infinite",
              st.lineNo,
            );
          env[st.var!] = v;
          (envSeen[st.var!] ??= new Set()).add(pyStr(v));
          runStmts(st.body!, env, flags);
        }
        continue;
      }
      if (st.kind === "def") {
        env[st.name!] = { __func: { params: st.params, body: st.body }, __name: st.name } as any;
        continue;
      }
      if (st.kind === "assignindex") {
        if (!(st.name! in env))
          throw new PyError("NameError", `name '${st.name}' is not defined`);
        const obj = env[st.name!];
        const key = evalExpr(st.idx!, env, flags);
        const v = evalExpr(st.expr!, env, flags);
        if (Array.isArray(obj)) {
          if (typeof key !== "number" || !Number.isInteger(key))
            throw new PyError("TypeError", "list indices must be integers");
          const i2 = key < 0 ? obj.length + key : key;
          if (i2 < 0 || i2 >= obj.length)
            throw new PyError("IndexError", "list assignment index out of range");
          obj[i2] = v;
        } else if (obj && typeof obj === "object" && !("__func" in obj)) {
          obj[String(key)] = v;
        } else {
          throw new PyError(
            "TypeError",
            `'${typeName(obj)}' object does not support item assignment`,
          );
        }
        continue;
      }
      if (st.kind === "with") {
        const handle = evalExpr(st.openExpr!, env, flags);
        if (!handle || typeof handle !== "object" || !("__file" in handle))
          throw new PyError(
            "TypeError",
            "'with' in this simulator supports open(file, mode)",
            st.lineNo,
          );
        env[st.var!] = handle;
        runStmts(st.body!, env, flags);
        continue;
      }
      if (st.kind === "import") {
        env[st.name!] = { __module: st.name } as any;
        continue;
      }
      if (st.kind === "try") {
        flags.add("try");
        try {
          runStmts(st.body!, env, flags);
        } catch (err: any) {
          if (err instanceof PyError) {
            const h = st.handlers!.find(
              (x) => !x.name || x.name === err.name || x.name === "Exception",
            );
            if (h) {
              flags.add("except");
              runStmts(h.body, env, flags);
            } else {
              if (st.finallyBody) runStmts(st.finallyBody, env, flags);
              throw err;
            }
          } else {
            if (st.finallyBody) runStmts(st.finallyBody, env, flags);
            throw err;
          }
        }
        if (st.finallyBody) runStmts(st.finallyBody!, env, flags);
        continue;
      }
      if (st.kind === "return") {
        throw { __return: st.expr ? evalExpr(st.expr, env, flags) : null };
      }
      // expr statement
      evalExpr(st.expr!, env, flags);
    }
  }

  /* ================= missions + UI ================= */

  let env: Record<string, Val> = {};
  let codeFlags = new Set<string>();
  let lastOutput: string[] = [];
  let allDoneShown = false;

  function isFunc(name: string): boolean {
    const v = env[name];
    return !!v && typeof v === "object" && "__func" in v;
  }

  const CHECKS: Record<string, () => boolean> = {
    p1: () => !!envSeen.rate?.has("150"),
    p2: () => !!envSeen.yen?.has("30000"),
    p3: () =>
      !!envSeen.usd &&
      (Array.from(envSeen.usd).some((v) => Math.abs(Number(v) - 200) < 0.01)),
    p4: () =>
      lastOutput.some((l) => l.includes("30000") && l.includes("200")),
    p5: () => lastOutput.some((l) => l.includes("200.00")),
    p6: () => codeFlags.has("if") && lastOutput.some((l) => l.includes("big")),
    p7: () =>
      env.yen === -500 &&
      codeFlags.has("if") &&
      !lastOutput.some((l) => /-3\.3/.test(l)),
    p8: () => lastOutput.some((l) => l === "mountain shadow"),
    /* week 4: loops and functions */
    l1: () =>
      Array.isArray(env.volumes) &&
      env.volumes.length === 7 &&
      env.volumes.every((v) => typeof v === "number"),
    l2: () =>
      codeFlags.has("for") &&
      [1000, 2000, 3000, 4000, 5000, 6000, 7000].every((v) =>
        lastOutput.some((l) => l.includes(String(v))),
      ),
    l3: () =>
      isFunc("total") &&
      lastOutput.some((l) => l.includes("28000")),
    l4: () =>
      isFunc("average") &&
      lastOutput.some((l) => l.includes("4000")),
    l5: () =>
      isFunc("best_day") &&
      lastOutput.some((l) => l.includes("best day: 7")),
    l6: () =>
      codeFlags.has("while") &&
      lastOutput.some((l) => l.includes("day 1")) &&
      lastOutput.some((l) => l.includes("day 7")),
    l7: () =>
      isFunc("yen_to_usd") &&
      lastOutput.some((l) => l.includes("USD") && /200/.test(l)),
    l8: () =>
      isFunc("report") &&
      lastOutput.some((l) => l.includes("total: 28000")) &&
      lastOutput.some((l) => l.includes("average: 4000")) &&
      lastOutput.some((l) => l.includes("best day: 7")),
    /* week 5: data structures and files */
    d1: () => Array.isArray(env.expenses),
    d2: () =>
      Array.isArray(env.expenses) &&
      env.expenses.some((x: any) => String(x).includes("coffee")),
    d3: () =>
      Array.isArray(env.expenses) &&
      env.expenses.length === 3 &&
      env.expenses.some((x: any) => String(x).includes("train")) &&
      env.expenses.some((x: any) => String(x).includes("lunch")),
    d4: () =>
      codeFlags.has("for") &&
      ["coffee", "train", "lunch"].every((w) =>
        lastOutput.some((l) => l.includes(w)),
      ),
    d5: () =>
      !!env.expense &&
      typeof env.expense === "object" &&
      !Array.isArray(env.expense) &&
      !("__func" in env.expense) &&
      lastOutput.some((l) => l.includes("coffee: 500 yen")),
    d6: () => {
      const c = simFiles["expenses.txt"] ?? simFiles["expenses.csv"] ?? "";
      return ["coffee", "train", "lunch"].every((w) => c.includes(w));
    },
    d7: () =>
      codeFlags.has("fileread") &&
      ["coffee", "train", "lunch"].every((w) =>
        lastOutput.some((l) => l.includes(w)),
      ),
    d8: () => lastOutput.some((l) => l.includes("total: 3400")),
    /* week 6: requests, JSON, try/except */
    r1: () => {
      const r = env.response as any;
      return !!r && typeof r === "object" && "__response" in r && r.__response.status_code === 200;
    },
    r2: () => lastOutput.some((l) => l.includes("149.98")),
    r3: () => lastOutput.some((l) => l.includes("163.55")),
    r4: () =>
      Array.isArray(env.rates) &&
      env.rates.length === 2 &&
      env.rates.some((x: any) => String(x).includes("149.98")) &&
      env.rates.some((x: any) => String(x).includes("163.55")),
    r5: () =>
      lastOutput.some((l) => l.includes("404")) &&
      lastOutput.some((l) => l.includes("skipping: bad status")),
    r6: () => lastOutput.some((l) => l.includes("recovered: 200")),
    r7: () =>
      codeFlags.has("except") &&
      lastOutput.some((l) => l.includes("handled: skipped")),
    r8: () => {
      const c = simFiles["rates.csv"] ?? "";
      return c.includes("149.98") && c.includes("163.55");
    },
  };

  function print(text: string, cls?: string): void {
    const div = document.createElement("div");
    div.className = cls ? `term-line ${cls}` : "term-line";
    div.textContent = text;
    out.appendChild(div);
  }

  function afterRun(): void {
    let allComplete = true;
    for (let i = 0; i < missionEls.length; i++) {
      const el = missionEls[i];
      if (el.dataset.done) continue;
      const id = el.dataset.mission!;
      if (CHECKS[id] && CHECKS[id]()) {
        el.dataset.done = "true";
        delete el.dataset.active;
        el.querySelector(".mission-hint")?.removeAttribute("open");
        print(missionCompleteTpl.replace("{n}", String(i + 1)), "term-success");
        continue;
      }
      allComplete = false;
      el.dataset.active = "true";
      return;
    }
    if (allComplete && !allDoneShown) {
      allDoneShown = true;
      print(missionsDoneMsg, "term-success");
    }
  }

  function run(): void {
    print("▶ run", "term-cmd");
    env = {};
    codeFlags = new Set();
    runPrinted = [];
    loopBudget = 10000;
    flakyCalls = 0;
    let pyError: PyError | { message: string } | null = null;
    try {
      const stmts = parseProgram(codeArea.value);
      runStmts(stmts, env, codeFlags);
    } catch (err: any) {
      if (err && err.__return !== undefined)
        pyError = new PyError("SyntaxError", "'return' outside function");
      else if (err instanceof PyError) pyError = err;
      else pyError = { message: err?.message ?? "invalid syntax" };
    }
    runPrinted.forEach((l) => print(l));
    if (pyError) {
      const e = pyError as PyError;
      if (e instanceof PyError) {
        const where = e.lineNo ? ` (line ${e.lineNo})` : "";
        print(`${e.name}: ${e.message}${where}`, "term-err");
        if (e.name === "SimNote")
          print(
            "hint: read the message above — it's a simulator limit, not your mistake",
            "term-info",
          );
      } else {
        print(`SyntaxError: ${e.message}`, "term-err");
      }
    } else if (runPrinted.length === 0) {
      print("(no output — use print() to show something)", "term-info");
    }
    lastOutput = runPrinted;
    afterRun();
  }

  runBtn.addEventListener("click", run);

  resetBtn.addEventListener("click", () => {
    codeArea.value = "";
    out.innerHTML = "";
    env = {};
    envSeen = {};
    codeFlags = new Set();
    lastOutput = [];
    allDoneShown = false;
    simFiles = {};
    persistFiles();
    flakyCalls = 0;
    missionEls.forEach((el, i) => {
      delete el.dataset.done;
      delete el.dataset.active;
      if (i === 0) el.dataset.active = "true";
      el.querySelector(".mission-hint")?.removeAttribute("open");
    });
    print("reset — editor, memory and FILES cleared (reset deletes the fake disk)", "term-info");
  });

  print(
    "mini-python — variables, strings, if/elif/else, loops, functions, lists, dicts, files",
    "term-info",
  );
  print(
    "files (open / write / read) persist between runs — like a real disk. Variables don't.",
    "term-info",
  );
  print("write a program in the editor and press Run", "term-info");
</script>
